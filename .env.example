# Copia este archivo a ".env" en la máquina del CPD y rellena los valores reales.
# "docker compose" lee automáticamente ".env" para las variables ${...} de docker-compose.yml.

# --- Públicas (se incrustan en el bundle del navegador al hacer build) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Subdominio final donde vive la app (usado para construir los enlaces de magic link)
NEXT_PUBLIC_SITE_URL=https://concursofotos.mairenadelalcor.net

# --- Privadas (solo se usan en el servidor, nunca llegan al navegador) ---
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
